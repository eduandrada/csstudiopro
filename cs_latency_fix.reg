Windows Registry Editor Version 5.00

; ==============================================================================
; CS 1.6 LOW LATENCY & NETWORK ACCELERATION TWEAKS (GOLDRSC ENGINE)
; ==============================================================================

; 1. Desactivar estrangulamiento de red multimedia y dar máxima prioridad a juegos
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile]
"NetworkThrottlingIndex"=dword:ffffffff
"SystemResponsiveness"=dword:00000000

; 2. Prioridad de tareas de juegos en el planificador de Windows (MMCSS)
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\Tasks\Games]
"Affinity"=dword:00000000
"Background Only"="False"
"Clock Rate"=dword:00002710
"GPU Priority"=dword:00000008
"Priority"=dword:00000006
"Scheduling Category"="High"
"SFIO Priority"="High"

; 3. Desactivar Nagle's Algorithm y Delayed ACK en interfaces de red TCP/IP
; Elimina el retardo de 200ms de Windows al esperar confirmación de paquetes
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters\Interfaces]

; 4. Optimización global de parámetros TCP/IP
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters]
"DefaultTTL"=dword:00000040
"EnableTCPA"=dword:00000001
"Tcp1323Opts"=dword:00000001
"MaxFreeTcbs"=dword:00010000
"MaxHashTableSize"=dword:00010000
"TcpAckFrequency"=dword:00000001
"TCPNoDelay"=dword:00000001
