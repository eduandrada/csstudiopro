# Configuración del Servidor
PORT=5000
FLASK_ENV=production
DEBUG=False

# Seguridad y Autenticación Criptográfica (JWT + bcrypt)
JWT_SECRET_KEY=cs16_studio_pro_ultra_secure_jwt_secret_key_2026_@goldsrc
